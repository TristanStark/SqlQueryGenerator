<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseAppHost>true</UseAppHost>
    <AssemblyName>SqlQueryGenerator.App</AssemblyName>
    <RootNamespace>SqlQueryGenerator</RootNamespace>
    <ApplicationIcon>logo.ico</ApplicationIcon>

    <!-- Keep every assembly version source aligned with the release tag. -->
    <Version>32.0.0</Version>
    <AssemblyVersion>32.0.0.0</AssemblyVersion>
    <FileVersion>32.0.0.0</FileVersion>
    <InformationalVersion>32.0.0</InformationalVersion>
    <Product>SqlQueryGenerator</Product>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SqlQueryGenerator.Core\SqlQueryGenerator.Core.csproj" />
  </ItemGroup>
</Project>
